# Advanced Inventory Management System
# COPY THIS FILE TO .env LOCALLY. Never commit a real .env or real credentials.

APP_NAME="Advanced Inventory Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# XAMPP / MySQL example. Change these values to match your local machine.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_management_system
DB_USERNAME=root
DB_PASSWORD=

# Laravel session/cache/queue defaults suitable for local XAMPP development.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Mock/local SMTP configuration.
# These values are placeholders only; replace them with real SMTP credentials.
# For local testing without an SMTP server, use MAIL_MAILER=log instead.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=inventory@example.com
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OTP security configuration.
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Fresh-install administrator seed values.
# Change these locally before running the seeder in a real environment.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Optional application integration placeholders.
# Keep secrets out of Git. Configure these in your local .env when the
# corresponding provider is actually connected.
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=UGX
PAYMENT_CALLBACK_URL=http://localhost/payment/callback
SMS_PROVIDER=mock
SMS_API_URL=https://api.example.com/sms
SMS_API_KEY=CHANGE_ME_SMS_KEY
