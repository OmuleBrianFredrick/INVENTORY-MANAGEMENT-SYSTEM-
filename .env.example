# Advanced Inventory Management System
# COPY THIS FILE TO .env LOCALLY. Never commit a real .env or real credentials.

APP_NAME="Advanced Inventory Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# XAMPP / MySQL example. Change these values to match your local machine.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_management_system
DB_USERNAME=root
DB_PASSWORD=

# Laravel session/cache/queue defaults suitable for local XAMPP development.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# SMTP configuration. Replace placeholders locally with real provider credentials.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=inventory@example.com
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OTP security configuration.
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Fresh-install administrator seed values.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Flutterwave v4 test/sandbox configuration.
# Never commit real credentials. Use the Test API Keys from the Flutterwave dashboard.
PAYMENT_PROVIDER=flutterwave
PAYMENT_CURRENCY=UGX
PAYMENT_CALLBACK_URL=http://127.0.0.1:8000/payment/callback
FLW_ENVIRONMENT=test
FLW_CLIENT_ID=CHANGE_ME_FLW_TEST_CLIENT_ID
FLW_CLIENT_SECRET=CHANGE_ME_FLW_TEST_CLIENT_SECRET
FLW_ENCRYPTION_KEY=CHANGE_ME_FLW_TEST_ENCRYPTION_KEY
FLW_SECRET_HASH=CHANGE_ME_FLW_WEBHOOK_SECRET_HASH
FLW_SANDBOX_BASE_URL=https://developersandbox-api.flutterwave.com
FLW_PRODUCTION_BASE_URL=https://f4bexperience.flutterwave.com
FLW_OAUTH_TOKEN_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token

# Optional SMS integration placeholders.
SMS_PROVIDER=mock
SMS_API_URL=https://api.example.com/sms
SMS_API_KEY=CHANGE_ME_SMS_KEY
